rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidResetTokenId(tokenId) {
      return tokenId is string &&
        tokenId.size() >= 12 &&
        tokenId.size() <= 96 &&
        tokenId.matches('^rst-[a-zA-Z0-9_\\-]+$');
    }

    function isValidShiftSignupId(signupId) {
      return signupId is string &&
        signupId.size() >= 8 &&
        signupId.size() <= 96 &&
        signupId.matches('^cand-[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdminEmail() {
      return isVerifiedUser() && request.auth.token.email == '270bis@live.it';
    }

    function isAdmin() {
      return isBootstrappedAdminEmail() ||
        (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOperator() {
      return isAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/operators/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/operators/$(request.auth.uid)).data.active == true
      );
    }

    function isAllowedShardId(shardId) {
      return shardId in [
        'mission',
        'volontari',
        'servizi',
        'turni',
        'bacheca',
        'magazzino',
        'timbrature',
        'indirizzi',
        'checklists',
        'config'
      ];
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidSyncShardData(data, shardId) {
      return data.keys().hasAll([
          'shardId',
          'version',
          'payload',
          'updatedByUid',
          'updatedByEmail',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'shardId',
          'version',
          'payload',
          'updatedByUid',
          'updatedByEmail',
          'createdAt',
          'updatedAt'
        ]) &&
        data.shardId is string &&
        data.shardId == shardId &&
        data.shardId.size() >= 2 &&
        data.shardId.size() <= 64 &&
        data.shardId.matches('^[a-z0-9_\\-]+$') &&
        data.version is number &&
        data.version >= 1 &&
        data.payload is map &&
        data.updatedByUid is string &&
        data.updatedByUid == request.auth.uid &&
        data.updatedByUid.size() >= 1 &&
        data.updatedByUid.size() <= 128 &&
        data.updatedByUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.updatedByEmail is string &&
        data.updatedByEmail.size() >= 3 &&
        data.updatedByEmail.size() <= 200 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidAdminData(data, targetUid) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'updatedByUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'updatedByUid', 'createdAt', 'updatedAt']) &&
        data.uid is string &&
        data.uid == targetUid &&
        isValidId(data.uid) &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 200 &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 120 &&
        data.updatedByUid is string &&
        data.updatedByUid == request.auth.uid &&
        data.updatedByUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidOperatorData(data, targetUid) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'active', 'updatedByUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'active', 'updatedByUid', 'createdAt', 'updatedAt']) &&
        data.uid is string &&
        data.uid == targetUid &&
        isValidId(data.uid) &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 200 &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 120 &&
        data.active is bool &&
        data.updatedByUid is string &&
        data.updatedByUid == request.auth.uid &&
        data.updatedByUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidOperatorRequestData(data, targetUid) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'status', 'createdAt', 'updatedAt']) &&
        data.uid is string &&
        data.uid == targetUid &&
        isValidId(data.uid) &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 200 &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 120 &&
        data.status is string &&
        data.status.size() >= 7 &&
        data.status.size() <= 12 &&
        data.status in ['pending', 'approved', 'rejected'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidPinResetData(data, tokenId) {
      return data.keys().hasAll([
          'tokenId',
          'volunteerId',
          'displayName',
          'qualifica',
          'pinProvvisorio',
          'pinProvvisorioVerifica',
          'status',
          'nuovoPin',
          'createdAt',
          'updatedAt',
          'completedAt'
        ]) &&
        data.keys().hasOnly([
          'tokenId',
          'volunteerId',
          'displayName',
          'qualifica',
          'pinProvvisorio',
          'pinProvvisorioVerifica',
          'status',
          'nuovoPin',
          'createdAt',
          'updatedAt',
          'completedAt'
        ]) &&
        data.tokenId is string &&
        data.tokenId == tokenId &&
        isValidResetTokenId(data.tokenId) &&
        data.volunteerId is string &&
        isValidId(data.volunteerId) &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 120 &&
        data.qualifica is string &&
        data.qualifica.size() >= 1 &&
        data.qualifica.size() <= 80 &&
        data.pinProvvisorio is string &&
        data.pinProvvisorio.size() == 4 &&
        data.pinProvvisorio.matches('^[0-9]{4}$') &&
        data.pinProvvisorioVerifica is string &&
        data.pinProvvisorioVerifica.size() == 4 &&
        data.pinProvvisorioVerifica.matches('^(----|[0-9]{4})$') &&
        data.status is string &&
        data.status in ['pending', 'completed', 'applied'] &&
        data.nuovoPin is string &&
        data.nuovoPin.size() <= 4 &&
        data.nuovoPin.matches('^(|[0-9]{4})$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time &&
        data.completedAt is timestamp;
    }

    function isValidPinResetProfileData(data, volId) {
      return data.keys().hasAll([
          'volunteerId',
          'emailHash',
          'pinHash',
          'tokenId',
          'status',
          'verifyingProofHash',
          'nuovoPin',
          'updatedByUid',
          'createdAt',
          'updatedAt',
          'completedAt'
        ]) &&
        data.keys().hasOnly([
          'volunteerId',
          'emailHash',
          'pinHash',
          'tokenId',
          'status',
          'verifyingProofHash',
          'nuovoPin',
          'updatedByUid',
          'createdAt',
          'updatedAt',
          'completedAt'
        ]) &&
        data.volunteerId is string &&
        data.volunteerId == volId &&
        isValidId(data.volunteerId) &&
        data.emailHash is string &&
        data.emailHash.size() <= 64 &&
        data.emailHash.matches('^(|[0-9a-f]{64})$') &&
        data.pinHash is string &&
        data.pinHash.size() <= 64 &&
        data.pinHash.matches('^(|[0-9a-f]{64})$') &&
        data.tokenId is string &&
        data.tokenId.size() <= 96 &&
        (data.tokenId == '' || isValidResetTokenId(data.tokenId)) &&
        data.status is string &&
        data.status in ['ready', 'pending', 'completed', 'applied'] &&
        data.verifyingProofHash is string &&
        data.verifyingProofHash.size() <= 64 &&
        data.verifyingProofHash.matches('^(----|[0-9a-f]{64})$') &&
        data.nuovoPin is string &&
        data.nuovoPin.size() <= 4 &&
        data.nuovoPin.matches('^(|[0-9]{4})$') &&
        data.updatedByUid is string &&
        data.updatedByUid.size() >= 1 &&
        data.updatedByUid.size() <= 128 &&
        isValidId(data.updatedByUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time &&
        data.completedAt is timestamp;
    }

    function isValidShiftSignupData(data, signupId) {
      return data.keys().hasAll([
          'signupId',
          'turnoId',
          'sedeNome',
          'turnoData',
          'turnoOrario',
          'volontarioId',
          'volontarioNome',
          'qualificaVolontario',
          'ruoloRichiesto',
          'note',
          'dataRichiesta',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'signupId',
          'turnoId',
          'sedeNome',
          'turnoData',
          'turnoOrario',
          'volontarioId',
          'volontarioNome',
          'qualificaVolontario',
          'ruoloRichiesto',
          'note',
          'dataRichiesta',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.signupId is string &&
        data.signupId == signupId &&
        isValidShiftSignupId(data.signupId) &&
        data.turnoId is string &&
        isValidId(data.turnoId) &&
        data.sedeNome is string &&
        data.sedeNome.size() >= 1 &&
        data.sedeNome.size() <= 120 &&
        data.turnoData is string &&
        data.turnoData.size() == 10 &&
        data.turnoData.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.turnoOrario is string &&
        data.turnoOrario.size() >= 1 &&
        data.turnoOrario.size() <= 32 &&
        data.volontarioId is string &&
        isValidId(data.volontarioId) &&
        data.volontarioNome is string &&
        data.volontarioNome.size() >= 1 &&
        data.volontarioNome.size() <= 120 &&
        data.qualificaVolontario is string &&
        data.qualificaVolontario.size() >= 1 &&
        data.qualificaVolontario.size() <= 80 &&
        data.ruoloRichiesto is string &&
        data.ruoloRichiesto in [
          'autista',
          'caposervizio',
          'soccorritore2',
          'terzoSoccorritore',
          'operatoreCentrale',
          'centralinista',
          'osservatore'
        ] &&
        data.note is string &&
        data.note.size() <= 300 &&
        data.dataRichiesta is string &&
        data.dataRichiesta.size() >= 1 &&
        data.dataRichiesta.size() <= 40 &&
        data.status is string &&
        data.status in ['pending', 'applied'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    // 4. Sharded Live Cloud State Collection
    match /sync_shards/{shardId} {
      allow get: if isValidId(shardId) && isAllowedShardId(shardId) && isOperator();
      allow list: if false;
      allow create: if isValidId(shardId) &&
        isAllowedShardId(shardId) &&
        isOperator() &&
        isValidSyncShardData(incoming(), shardId) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(shardId) &&
        isAllowedShardId(shardId) &&
        isOperator() &&
        isValidSyncShardData(incoming(), shardId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().shardId == existing().shardId &&
        (
          isAdmin() ||
          (
            incoming().version > existing().version &&
            incoming().diff(existing()).affectedKeys().hasOnly(['payload', 'version', 'updatedAt', 'updatedByUid', 'updatedByEmail'])
          )
        );
      allow delete: if isValidId(shardId) && isAdmin();
    }

    // 5. Admin Registry
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isAdmin() || (isVerifiedUser() && request.auth.uid == adminUid));
      allow list: if false;
      allow create: if isValidId(adminUid) &&
        isAdmin() &&
        isValidAdminData(incoming(), adminUid) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(adminUid) &&
        isAdmin() &&
        isValidAdminData(incoming(), adminUid) &&
        incoming().createdAt == existing().createdAt &&
        incoming().uid == existing().uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt', 'updatedByUid']);
      allow delete: if isValidId(adminUid) && isAdmin() && adminUid != request.auth.uid;
    }

    // 6. Approved Operator Terminals
    match /operators/{operatorUid} {
      allow get: if isValidId(operatorUid) && (isAdmin() || (isVerifiedUser() && request.auth.uid == operatorUid));
      allow list: if isVerifiedUser() && (
        request.auth.token.email == '270bis@live.it' ||
        resource.data.uid == request.auth.uid
      );
      allow create: if isValidId(operatorUid) &&
        isAdmin() &&
        isValidOperatorData(incoming(), operatorUid) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(operatorUid) &&
        isAdmin() &&
        isValidOperatorData(incoming(), operatorUid) &&
        incoming().createdAt == existing().createdAt &&
        incoming().uid == existing().uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'active', 'updatedAt', 'updatedByUid']);
      allow delete: if isValidId(operatorUid) && isAdmin();
    }

    // 7. Operator Access Requests (PII-isolated to owner + bootstrapped Admin)
    match /operator_requests/{requestUid} {
      allow get: if isValidId(requestUid) && (isAdmin() || (isVerifiedUser() && request.auth.uid == requestUid));
      allow list: if isVerifiedUser() && (
        request.auth.token.email == '270bis@live.it' ||
        resource.data.uid == request.auth.uid
      );
      allow create: if isValidId(requestUid) &&
        isVerifiedUser() &&
        request.auth.uid == requestUid &&
        isValidOperatorRequestData(incoming(), requestUid) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time;
      allow update: if isValidId(requestUid) &&
        isVerifiedUser() &&
        isValidOperatorRequestData(incoming(), requestUid) &&
        incoming().createdAt == existing().createdAt &&
        incoming().uid == existing().uid &&
        (
          isAdmin() ||
          (
            request.auth.uid == requestUid &&
            existing().status == 'pending' &&
            incoming().status == 'pending' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt'])
          )
        );
      allow delete: if isValidId(requestUid) && (isAdmin() || (isVerifiedUser() && request.auth.uid == requestUid));
    }

    // 8. Token-Scoped Zero-PII PIN Reset Tickets (works without Google / AI Studio auth)
    match /pin_resets/{tokenId} {
      allow get: if isValidResetTokenId(tokenId);
      allow list: if false;
      allow create: if isValidResetTokenId(tokenId) &&
        isOperator() &&
        isValidPinResetData(incoming(), tokenId) &&
        incoming().status == 'pending' &&
        incoming().nuovoPin == '' &&
        incoming().pinProvvisorioVerifica == '----' &&
        incoming().createdAt == request.time &&
        incoming().completedAt == request.time;
      allow update: if isValidResetTokenId(tokenId) &&
        isValidPinResetData(incoming(), tokenId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().tokenId == existing().tokenId &&
        incoming().volunteerId == existing().volunteerId &&
        incoming().displayName == existing().displayName &&
        incoming().qualifica == existing().qualifica &&
        incoming().pinProvvisorio == existing().pinProvvisorio &&
        (
          (
            isOperator() &&
            incoming().status in ['pending', 'completed', 'applied']
          ) ||
          (
            existing().status == 'pending' &&
            incoming().status == 'completed' &&
            incoming().pinProvvisorioVerifica == existing().pinProvvisorio &&
            incoming().nuovoPin.matches('^[0-9]{4}$') &&
            incoming().nuovoPin != '4451' &&
            incoming().nuovoPin != existing().pinProvvisorio &&
            incoming().completedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'nuovoPin',
              'pinProvvisorioVerifica',
              'updatedAt',
              'completedAt'
            ])
          )
        );
      allow delete: if isValidResetTokenId(tokenId) && isOperator();
    }

    // 9. Zero-PII Write-Only Verification Index for In-App PIN Reset (No Google Auth, No Offline Scrape)
    match /pin_reset_profiles/{volunteerId} {
      allow get: if isValidId(volunteerId) && isOperator();
      allow list: if isOperator();
      allow create: if isValidId(volunteerId) &&
        isOperator() &&
        isValidPinResetProfileData(incoming(), volunteerId) &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().status in ['ready', 'pending', 'applied'] &&
        incoming().nuovoPin == '' &&
        incoming().verifyingProofHash == '----' &&
        incoming().createdAt == request.time &&
        incoming().completedAt == request.time;
      allow update: if isValidId(volunteerId) &&
        isValidPinResetProfileData(incoming(), volunteerId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().volunteerId == existing().volunteerId &&
        (
          (
            isOperator() &&
            incoming().updatedByUid == request.auth.uid
          ) ||
          (
            existing().status in ['ready', 'pending', 'applied'] &&
            incoming().status == 'completed' &&
            incoming().emailHash == existing().emailHash &&
            incoming().pinHash == existing().pinHash &&
            incoming().tokenId == existing().tokenId &&
            incoming().updatedByUid == existing().updatedByUid &&
            incoming().verifyingProofHash.matches('^[0-9a-f]{64}$') &&
            (
              (existing().emailHash.matches('^[0-9a-f]{64}$') && incoming().verifyingProofHash == existing().emailHash) ||
              (existing().pinHash.matches('^[0-9a-f]{64}$') && incoming().verifyingProofHash == existing().pinHash)
            ) &&
            incoming().nuovoPin.matches('^[0-9]{4}$') &&
            incoming().nuovoPin != '4451' &&
            incoming().completedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'nuovoPin',
              'verifyingProofHash',
              'updatedAt',
              'completedAt'
            ])
          )
        );
      allow delete: if isValidId(volunteerId) && isOperator();
    }

    // 10. Zero-PII Volunteer Shift Sign-Up Queue (works without Google / AI Studio auth)
    match /shift_signups/{signupId} {
      allow get: if isValidShiftSignupId(signupId);
      allow list: if isOperator();
      allow create: if isValidShiftSignupId(signupId) &&
        isValidShiftSignupData(incoming(), signupId) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time;
      allow update: if isValidShiftSignupId(signupId) &&
        isOperator() &&
        isValidShiftSignupData(incoming(), signupId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().signupId == existing().signupId &&
        incoming().status in ['pending', 'applied'];
      allow delete: if isValidShiftSignupId(signupId) && isOperator();
    }

    // 11. Boot Health Check Doc (no PII)
    match /test/{docId} {
      allow get: if isValidId(docId) && docId == 'connection' && isOperator();
      allow list, write: if false;
    }
  }
}
