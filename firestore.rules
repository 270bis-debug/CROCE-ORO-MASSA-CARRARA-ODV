rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidResetTokenId(tokenId) {
      return tokenId is string &&
        tokenId.size() >= 12 &&
        tokenId.size() <= 96 &&
        tokenId.matches('^rst-[a-zA-Z0-9_\\-]+$');
    }

    function isValidShiftSignupId(signupId) {
      return signupId is string &&
        signupId.size() >= 8 &&
        signupId.size() <= 96 &&
        signupId.matches('^cand-[a-zA-Z0-9_\\-]+$');
    }

    function isValidCourseTokenId(tokenId) {
      return tokenId is string &&
        tokenId.size() >= 10 &&
        tokenId.size() <= 96 &&
        tokenId.matches('^crs-[a-zA-Z0-9_\\-]+$');
    }

    function isValidCourseGuestCheckinId(checkinId) {
      return checkinId is string &&
        checkinId.size() >= 8 &&
        checkinId.size() <= 96 &&
        checkinId.matches('^chk-[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdminEmail() {
      return isVerifiedUser() && request.auth.token.email == '270bis@live.it';
    }

    function isAdmin() {
      return isBootstrappedAdminEmail() ||
        (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOperator() {
      return isAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/operators/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/operators/$(request.auth.uid)).data.active == true
      );
    }

    function isAllowedShardId(shardId) {
      return shardId in [
        'mission',
        'volontari',
        'servizi',
        'turni',
        'bacheca',
        'magazzino',
        'timbrature',
        'indirizzi',
        'checklists',
        'config'
      ];
    }

    function isAllowedRadioSlotId(slotId) {
      return slotId in [
        'live_state',
        'last_tx',
        'slot_0',
        'slot_1',
        'slot_2',
        'slot_3',
        'slot_4',
        'slot_5',
        'slot_6',
        'slot_7',
        'slot_8',
        'slot_9',
        'slot_10',
        'slot_11'
      ];
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidSyncShardData(data, shardId) {
      return data.keys().hasAll([
          'shardId',
          'version',
          'payload',
          'updatedByUid',
          'updatedByEmail',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'shardId',
          'version',
          'payload',
          'updatedByUid',
          'updatedByEmail',
          'createdAt',
          'updatedAt'
        ]) &&
        data.shardId is string &&
        data.shardId == shardId &&
        data.shardId.size() >= 2 &&
        data.shardId.size() <= 64 &&
        data.shardId.matches('^[a-z0-9_\\-]+$') &&
        data.version is number &&
        data.version >= 1 &&
        data.payload is map &&
        data.updatedByUid is string &&
        data.updatedByUid == request.auth.uid &&
        data.updatedByUid.size() >= 1 &&
        data.updatedByUid.size() <= 128 &&
        data.updatedByUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.updatedByEmail is string &&
        data.updatedByEmail.size() >= 3 &&
        data.updatedByEmail.size() <= 200 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidRadioSlotData(data, slotId) {
      return data.keys().hasAll([
          'slotId',
          'scope',
          'txId',
          'channelId',
          'payload',
          'sentAtMs',
          'updatedByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'slotId',
          'scope',
          'txId',
          'channelId',
          'payload',
          'sentAtMs',
          'updatedByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.slotId is string &&
        data.slotId == slotId &&
        data.slotId.size() >= 5 &&
        data.slotId.size() <= 32 &&
        isAllowedRadioSlotId(data.slotId) &&
        data.scope is string &&
        data.scope == 'croce_oro_radio' &&
        data.scope.size() == 15 &&
        data.txId is string &&
        data.txId.size() <= 96 &&
        data.channelId is string &&
        data.channelId.size() >= 1 &&
        data.channelId.size() <= 96 &&
        data.payload is map &&
        data.sentAtMs is number &&
        data.sentAtMs >= 0 &&
        data.updatedByUid is string &&
        data.updatedByUid == request.auth.uid &&
        isValidId(data.updatedByUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidPushSubscriptionData(data, subId) {
      return data.keys().hasAll([
          'subId',
          'scope',
          'role',
          'volontarioId',
          'endpoint',
          'p256dh',
          'auth',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'subId',
          'scope',
          'role',
          'volontarioId',
          'endpoint',
          'p256dh',
          'auth',
          'ownerUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.subId is string &&
        data.subId == subId &&
        data.subId.size() >= 4 &&
        data.subId.size() <= 128 &&
        isValidId(data.subId) &&
        data.scope is string &&
        data.scope == 'croce_oro_push' &&
        data.scope.size() == 14 &&
        data.role is string &&
        data.role.size() >= 3 &&
        data.role.size() <= 16 &&
        data.role in ['admin', 'centrale', 'volontario', 'all'] &&
        data.volontarioId is string &&
        data.volontarioId.size() <= 128 &&
        data.endpoint is string &&
        data.endpoint.size() >= 12 &&
        data.endpoint.size() <= 1024 &&
        data.endpoint.matches('^https://.*$') &&
        data.p256dh is string &&
        data.p256dh.size() >= 16 &&
        data.p256dh.size() <= 256 &&
        data.auth is string &&
        data.auth.size() >= 8 &&
        data.auth.size() <= 128 &&
        data.ownerUid is string &&
        data.ownerUid == request.auth.uid &&
        isValidId(data.ownerUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidPublicRosterData(data, rosterId) {
      return data.keys().hasAll([
          'rosterId',
          'version',
          'entries',
          'deletedIds',
          'updatedByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'rosterId',
          'version',
          'entries',
          'deletedIds',
          'updatedByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.rosterId is string &&
        data.rosterId == rosterId &&
        data.rosterId == 'volunteers_v1' &&
        data.rosterId.size() == 13 &&
        data.rosterId.matches('^volunteers_v1$') &&
        data.version is number &&
        data.version >= 1 &&
        data.entries is list &&
        data.entries.size() <= 400 &&
        (data.entries.size() == 0 || data.entries[0] is map) &&
        data.deletedIds is list &&
        data.deletedIds.size() <= 300 &&
        (data.deletedIds.size() == 0 || data.deletedIds[0] is string) &&
        data.updatedByUid is string &&
        data.updatedByUid == request.auth.uid &&
        isValidId(data.updatedByUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidPublicBoardData(data, boardId) {
      return data.keys().hasAll([
          'boardId',
          'version',
          'turni',
          'sedi',
          'updatedByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'boardId',
          'version',
          'turni',
          'sedi',
          'updatedByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.boardId is string &&
        data.boardId == boardId &&
        data.boardId == 'shifts_v1' &&
        data.boardId.size() == 9 &&
        data.boardId.matches('^shifts_v1$') &&
        data.version is number &&
        data.version >= 1 &&
        data.turni is list &&
        data.turni.size() <= 1500 &&
        (data.turni.size() == 0 || data.turni[0] is map) &&
        data.sedi is list &&
        data.sedi.size() <= 60 &&
        (data.sedi.size() == 0 || data.sedi[0] is map) &&
        data.updatedByUid is string &&
        data.updatedByUid == request.auth.uid &&
        isValidId(data.updatedByUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidPublicRaspberryData(data, boardId) {
      return data.keys().hasAll([
          'boardId',
          'version',
          'sedi',
          'bacheca',
          'timbrature',
          'config',
          'updatedByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'boardId',
          'version',
          'sedi',
          'bacheca',
          'timbrature',
          'config',
          'updatedByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.boardId is string &&
        data.boardId == boardId &&
        data.boardId == 'display_v1' &&
        data.boardId.size() == 10 &&
        data.boardId.matches('^display_v1$') &&
        data.version is number &&
        data.version >= 1 &&
        data.sedi is list &&
        data.sedi.size() <= 60 &&
        (data.sedi.size() == 0 || data.sedi[0] is map) &&
        data.bacheca is list &&
        data.bacheca.size() <= 150 &&
        (data.bacheca.size() == 0 || data.bacheca[0] is map) &&
        data.timbrature is list &&
        data.timbrature.size() <= 350 &&
        (data.timbrature.size() == 0 || data.timbrature[0] is map) &&
        data.config is map &&
        data.updatedByUid is string &&
        data.updatedByUid == request.auth.uid &&
        isValidId(data.updatedByUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidAdminData(data, targetUid) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'updatedByUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'updatedByUid', 'createdAt', 'updatedAt']) &&
        data.uid is string &&
        data.uid == targetUid &&
        isValidId(data.uid) &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 200 &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 120 &&
        data.updatedByUid is string &&
        data.updatedByUid == request.auth.uid &&
        data.updatedByUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidOperatorData(data, targetUid) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'active', 'updatedByUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'active', 'updatedByUid', 'createdAt', 'updatedAt']) &&
        data.uid is string &&
        data.uid == targetUid &&
        isValidId(data.uid) &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 200 &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 120 &&
        data.active is bool &&
        data.updatedByUid is string &&
        data.updatedByUid == request.auth.uid &&
        data.updatedByUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidOperatorRequestData(data, targetUid) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'status', 'createdAt', 'updatedAt']) &&
        data.uid is string &&
        data.uid == targetUid &&
        isValidId(data.uid) &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 200 &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 120 &&
        data.status is string &&
        data.status.size() >= 7 &&
        data.status.size() <= 12 &&
        data.status in ['pending', 'approved', 'rejected'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidPinResetData(data, tokenId) {
      return data.keys().hasAll([
          'tokenId',
          'volunteerId',
          'displayName',
          'qualifica',
          'pinProvvisorio',
          'pinProvvisorioVerifica',
          'status',
          'nuovoPin',
          'createdAt',
          'updatedAt',
          'completedAt'
        ]) &&
        data.keys().hasOnly([
          'tokenId',
          'volunteerId',
          'displayName',
          'qualifica',
          'pinProvvisorio',
          'pinProvvisorioVerifica',
          'status',
          'nuovoPin',
          'createdAt',
          'updatedAt',
          'completedAt'
        ]) &&
        data.tokenId is string &&
        data.tokenId == tokenId &&
        isValidResetTokenId(data.tokenId) &&
        data.volunteerId is string &&
        isValidId(data.volunteerId) &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 120 &&
        data.qualifica is string &&
        data.qualifica.size() >= 1 &&
        data.qualifica.size() <= 80 &&
        data.pinProvvisorio is string &&
        data.pinProvvisorio.size() == 4 &&
        data.pinProvvisorio.matches('^[0-9]{4}$') &&
        data.pinProvvisorioVerifica is string &&
        data.pinProvvisorioVerifica.size() == 4 &&
        data.pinProvvisorioVerifica.matches('^(----|[0-9]{4})$') &&
        data.status is string &&
        data.status in ['pending', 'completed', 'applied'] &&
        data.nuovoPin is string &&
        data.nuovoPin.size() <= 4 &&
        data.nuovoPin.matches('^(|[0-9]{4})$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time &&
        data.completedAt is timestamp;
    }

    function isValidPinResetProfileData(data, volId) {
      return data.keys().hasAll([
          'volunteerId',
          'emailHash',
          'pinHash',
          'tokenId',
          'status',
          'verifyingProofHash',
          'nuovoPin',
          'updatedByUid',
          'createdAt',
          'updatedAt',
          'completedAt'
        ]) &&
        data.keys().hasOnly([
          'volunteerId',
          'emailHash',
          'pinHash',
          'tokenId',
          'status',
          'verifyingProofHash',
          'nuovoPin',
          'updatedByUid',
          'createdAt',
          'updatedAt',
          'completedAt'
        ]) &&
        data.volunteerId is string &&
        data.volunteerId == volId &&
        isValidId(data.volunteerId) &&
        data.emailHash is string &&
        data.emailHash.size() <= 64 &&
        data.emailHash.matches('^(|[0-9a-f]{64})$') &&
        data.pinHash is string &&
        data.pinHash.size() <= 64 &&
        data.pinHash.matches('^(|[0-9a-f]{64})$') &&
        data.tokenId is string &&
        data.tokenId.size() <= 96 &&
        (data.tokenId == '' || isValidResetTokenId(data.tokenId)) &&
        data.status is string &&
        data.status in ['ready', 'pending', 'completed', 'applied'] &&
        data.verifyingProofHash is string &&
        data.verifyingProofHash.size() <= 64 &&
        data.verifyingProofHash.matches('^(----|[0-9a-f]{64})$') &&
        data.nuovoPin is string &&
        data.nuovoPin.size() <= 4 &&
        data.nuovoPin.matches('^(|[0-9]{4})$') &&
        data.updatedByUid is string &&
        data.updatedByUid.size() >= 1 &&
        data.updatedByUid.size() <= 128 &&
        isValidId(data.updatedByUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time &&
        data.completedAt is timestamp;
    }

    function isValidShiftSignupData(data, signupId) {
      return data.keys().hasAll([
          'signupId',
          'turnoId',
          'sedeNome',
          'turnoData',
          'turnoOrario',
          'volontarioId',
          'volontarioNome',
          'qualificaVolontario',
          'ruoloRichiesto',
          'note',
          'dataRichiesta',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'signupId',
          'turnoId',
          'sedeNome',
          'turnoData',
          'turnoOrario',
          'volontarioId',
          'volontarioNome',
          'qualificaVolontario',
          'ruoloRichiesto',
          'note',
          'dataRichiesta',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.signupId is string &&
        data.signupId == signupId &&
        isValidShiftSignupId(data.signupId) &&
        data.turnoId is string &&
        isValidId(data.turnoId) &&
        data.sedeNome is string &&
        data.sedeNome.size() >= 1 &&
        data.sedeNome.size() <= 120 &&
        data.turnoData is string &&
        data.turnoData.size() == 10 &&
        data.turnoData.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.turnoOrario is string &&
        data.turnoOrario.size() >= 1 &&
        data.turnoOrario.size() <= 32 &&
        data.volontarioId is string &&
        isValidId(data.volontarioId) &&
        data.volontarioNome is string &&
        data.volontarioNome.size() >= 1 &&
        data.volontarioNome.size() <= 120 &&
        data.qualificaVolontario is string &&
        data.qualificaVolontario.size() >= 1 &&
        data.qualificaVolontario.size() <= 80 &&
        data.ruoloRichiesto is string &&
        data.ruoloRichiesto in [
          'autista',
          'caposervizio',
          'soccorritore2',
          'terzoSoccorritore',
          'operatoreCentrale',
          'centralinista',
          'osservatore'
        ] &&
        data.note is string &&
        data.note.size() <= 300 &&
        data.dataRichiesta is string &&
        data.dataRichiesta.size() >= 1 &&
        data.dataRichiesta.size() <= 40 &&
        data.status is string &&
        data.status in ['pending', 'applied'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidPublicCourseData(data, tokenId) {
      return data.keys().hasAll([
          'tokenId',
          'corsoId',
          'titolo',
          'categoria',
          'dataInizio',
          'dataFine',
          'oreTotaliRichieste',
          'aulaNome',
          'aulaIndirizzo',
          'coordinate',
          'raggioMetri',
          'lezioni',
          'attivo',
          'updatedByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'tokenId',
          'corsoId',
          'titolo',
          'categoria',
          'dataInizio',
          'dataFine',
          'oreTotaliRichieste',
          'aulaNome',
          'aulaIndirizzo',
          'coordinate',
          'raggioMetri',
          'lezioni',
          'attivo',
          'updatedByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.tokenId is string &&
        data.tokenId == tokenId &&
        isValidCourseTokenId(data.tokenId) &&
        data.corsoId is string &&
        data.corsoId.size() >= 1 &&
        data.corsoId.size() <= 128 &&
        data.titolo is string &&
        data.titolo.size() >= 1 &&
        data.titolo.size() <= 180 &&
        data.categoria is string &&
        data.categoria.size() >= 1 &&
        data.categoria.size() <= 80 &&
        data.dataInizio is string &&
        data.dataInizio.size() >= 4 &&
        data.dataInizio.size() <= 24 &&
        data.dataFine is string &&
        data.dataFine.size() <= 24 &&
        data.oreTotaliRichieste is number &&
        data.oreTotaliRichieste >= 0 &&
        data.oreTotaliRichieste <= 2000 &&
        data.aulaNome is string &&
        data.aulaNome.size() >= 1 &&
        data.aulaNome.size() <= 160 &&
        data.aulaIndirizzo is string &&
        data.aulaIndirizzo.size() <= 220 &&
        data.coordinate is map &&
        data.coordinate.keys().hasAll(['lat', 'lng']) &&
        data.coordinate.keys().hasOnly(['lat', 'lng']) &&
        data.coordinate.lat is number &&
        data.coordinate.lng is number &&
        data.raggioMetri is number &&
        data.raggioMetri >= 10 &&
        data.raggioMetri <= 2000 &&
        data.lezioni is list &&
        data.lezioni.size() <= 40 &&
        (data.lezioni.size() == 0 || data.lezioni[0] is map) &&
        data.attivo is bool &&
        data.updatedByUid is string &&
        data.updatedByUid == request.auth.uid &&
        isValidId(data.updatedByUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidCourseGuestCheckinData(data, checkinId) {
      return data.keys().hasAll([
          'checkinId',
          'scope',
          'tokenId',
          'corsoId',
          'lezioneId',
          'nome',
          'cognome',
          'telefono',
          'tipo',
          'dataOra',
          'aulaNome',
          'distanzaMetri',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'checkinId',
          'scope',
          'tokenId',
          'corsoId',
          'lezioneId',
          'nome',
          'cognome',
          'telefono',
          'tipo',
          'dataOra',
          'aulaNome',
          'distanzaMetri',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.checkinId is string &&
        data.checkinId == checkinId &&
        isValidCourseGuestCheckinId(data.checkinId) &&
        data.scope is string &&
        data.scope == 'croce_oro_course_guest' &&
        data.scope.size() == 22 &&
        data.tokenId is string &&
        isValidCourseTokenId(data.tokenId) &&
        data.corsoId is string &&
        data.corsoId.size() >= 1 &&
        data.corsoId.size() <= 128 &&
        data.lezioneId is string &&
        data.lezioneId.size() <= 128 &&
        data.nome is string &&
        data.nome.size() >= 1 &&
        data.nome.size() <= 80 &&
        data.cognome is string &&
        data.cognome.size() >= 1 &&
        data.cognome.size() <= 80 &&
        data.telefono is string &&
        data.telefono.size() >= 5 &&
        data.telefono.size() <= 32 &&
        data.tipo is string &&
        data.tipo in ['entrata', 'uscita'] &&
        data.dataOra is string &&
        data.dataOra.size() >= 8 &&
        data.dataOra.size() <= 40 &&
        data.aulaNome is string &&
        data.aulaNome.size() >= 1 &&
        data.aulaNome.size() <= 160 &&
        data.distanzaMetri is number &&
        data.distanzaMetri >= 0 &&
        data.distanzaMetri <= 50000 &&
        data.status is string &&
        data.status in ['pending', 'applied'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidVolunteerActivityData(data, volId) {
      return data.keys().hasAll([
          'volunteerId',
          'scope',
          'verifyingPinHash',
          'loggato',
          'lastHeartbeatMs',
          'volontarioNome',
          'mezzoScelto',
          'orarioInizio',
          'qualificaTurno',
          'firmaBase64',
          'firmaUpdatedAtMs',
          'firmaApplied',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'volunteerId',
          'scope',
          'verifyingPinHash',
          'loggato',
          'lastHeartbeatMs',
          'volontarioNome',
          'mezzoScelto',
          'orarioInizio',
          'qualificaTurno',
          'firmaBase64',
          'firmaUpdatedAtMs',
          'firmaApplied',
          'createdAt',
          'updatedAt'
        ]) &&
        data.volunteerId is string &&
        data.volunteerId == volId &&
        isValidId(data.volunteerId) &&
        data.scope is string &&
        data.scope == 'croce_oro_vol_activity' &&
        data.scope.size() == 22 &&
        data.verifyingPinHash is string &&
        data.verifyingPinHash.size() == 64 &&
        data.verifyingPinHash.matches('^[0-9a-f]{64}$') &&
        data.loggato is bool &&
        data.lastHeartbeatMs is int &&
        data.lastHeartbeatMs >= 0 &&
        data.lastHeartbeatMs <= 4102444800000 &&
        data.volontarioNome is string &&
        data.volontarioNome.size() <= 120 &&
        data.mezzoScelto is string &&
        data.mezzoScelto.size() <= 80 &&
        data.orarioInizio is string &&
        data.orarioInizio.size() <= 32 &&
        data.qualificaTurno is string &&
        data.qualificaTurno.size() <= 80 &&
        data.firmaBase64 is string &&
        data.firmaBase64.size() <= 220000 &&
        (
          data.firmaBase64 == '' ||
          data.firmaBase64.matches('^data:image/(png|jpeg|jpg|webp);base64,[A-Za-z0-9+/=]+$')
        ) &&
        data.firmaUpdatedAtMs is int &&
        data.firmaUpdatedAtMs >= 0 &&
        data.firmaUpdatedAtMs <= 4102444800000 &&
        data.firmaApplied is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    // 4. Sharded Live Cloud State Collection
    match /sync_shards/{shardId} {
      allow get: if isValidId(shardId) && isAllowedShardId(shardId) && isOperator();
      allow list: if false;
      allow create: if isValidId(shardId) &&
        isAllowedShardId(shardId) &&
        isOperator() &&
        isValidSyncShardData(incoming(), shardId) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(shardId) &&
        isAllowedShardId(shardId) &&
        isOperator() &&
        isValidSyncShardData(incoming(), shardId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().shardId == existing().shardId &&
        (
          isAdmin() ||
          (
            incoming().version > existing().version &&
            incoming().diff(existing()).affectedKeys().hasOnly(['payload', 'version', 'updatedAt', 'updatedByUid', 'updatedByEmail'])
          )
        );
      allow delete: if isValidId(shardId) && isAdmin();
    }

    // 5. Admin Registry
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isAdmin() || (isVerifiedUser() && request.auth.uid == adminUid));
      allow list: if false;
      allow create: if isValidId(adminUid) &&
        isAdmin() &&
        isValidAdminData(incoming(), adminUid) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(adminUid) &&
        isAdmin() &&
        isValidAdminData(incoming(), adminUid) &&
        incoming().createdAt == existing().createdAt &&
        incoming().uid == existing().uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt', 'updatedByUid']);
      allow delete: if isValidId(adminUid) && isAdmin() && adminUid != request.auth.uid;
    }

    // 6. Approved Operator Terminals
    match /operators/{operatorUid} {
      allow get: if isValidId(operatorUid) && (isAdmin() || (isVerifiedUser() && request.auth.uid == operatorUid));
      allow list: if isVerifiedUser() && (
        request.auth.token.email == '270bis@live.it' ||
        resource.data.uid == request.auth.uid
      );
      allow create: if isValidId(operatorUid) &&
        isAdmin() &&
        isValidOperatorData(incoming(), operatorUid) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(operatorUid) &&
        isAdmin() &&
        isValidOperatorData(incoming(), operatorUid) &&
        incoming().createdAt == existing().createdAt &&
        incoming().uid == existing().uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'active', 'updatedAt', 'updatedByUid']);
      allow delete: if isValidId(operatorUid) && isAdmin();
    }

    // 7. Operator Access Requests (PII-isolated to owner + bootstrapped Admin)
    match /operator_requests/{requestUid} {
      allow get: if isValidId(requestUid) && (isAdmin() || (isVerifiedUser() && request.auth.uid == requestUid));
      allow list: if isVerifiedUser() && (
        request.auth.token.email == '270bis@live.it' ||
        resource.data.uid == request.auth.uid
      );
      allow create: if isValidId(requestUid) &&
        isVerifiedUser() &&
        request.auth.uid == requestUid &&
        isValidOperatorRequestData(incoming(), requestUid) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time;
      allow update: if isValidId(requestUid) &&
        isVerifiedUser() &&
        isValidOperatorRequestData(incoming(), requestUid) &&
        incoming().createdAt == existing().createdAt &&
        incoming().uid == existing().uid &&
        (
          isAdmin() ||
          (
            request.auth.uid == requestUid &&
            existing().status == 'pending' &&
            incoming().status == 'pending' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt'])
          )
        );
      allow delete: if isValidId(requestUid) && (isAdmin() || (isVerifiedUser() && request.auth.uid == requestUid));
    }

    // 8. Token-Scoped Zero-PII PIN Reset Tickets (works without Google / AI Studio auth)
    match /pin_resets/{tokenId} {
      allow get: if isValidResetTokenId(tokenId);
      allow list: if false;
      allow create: if isValidResetTokenId(tokenId) &&
        isOperator() &&
        isValidPinResetData(incoming(), tokenId) &&
        incoming().status == 'pending' &&
        incoming().nuovoPin == '' &&
        incoming().pinProvvisorioVerifica == '----' &&
        incoming().createdAt == request.time &&
        incoming().completedAt == request.time;
      allow update: if isValidResetTokenId(tokenId) &&
        isValidPinResetData(incoming(), tokenId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().tokenId == existing().tokenId &&
        incoming().volunteerId == existing().volunteerId &&
        incoming().displayName == existing().displayName &&
        incoming().qualifica == existing().qualifica &&
        incoming().pinProvvisorio == existing().pinProvvisorio &&
        (
          (
            isOperator() &&
            incoming().status in ['pending', 'completed', 'applied']
          ) ||
          (
            existing().status == 'pending' &&
            incoming().status == 'completed' &&
            incoming().pinProvvisorioVerifica == existing().pinProvvisorio &&
            incoming().nuovoPin.matches('^[0-9]{4}$') &&
            incoming().nuovoPin != '4451' &&
            incoming().nuovoPin != existing().pinProvvisorio &&
            incoming().completedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'nuovoPin',
              'pinProvvisorioVerifica',
              'updatedAt',
              'completedAt'
            ])
          )
        );
      allow delete: if isValidResetTokenId(tokenId) && isOperator();
    }

    // 9. Zero-PII Write-Only Verification Index for In-App PIN Reset (No Google Auth, No Offline Scrape)
    match /pin_reset_profiles/{volunteerId} {
      allow get: if isValidId(volunteerId) && isOperator();
      allow list: if isOperator();
      allow create: if isValidId(volunteerId) &&
        isOperator() &&
        isValidPinResetProfileData(incoming(), volunteerId) &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().status in ['ready', 'pending', 'applied'] &&
        incoming().nuovoPin == '' &&
        incoming().verifyingProofHash == '----' &&
        incoming().createdAt == request.time &&
        incoming().completedAt == request.time;
      allow update: if isValidId(volunteerId) &&
        isValidPinResetProfileData(incoming(), volunteerId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().volunteerId == existing().volunteerId &&
        (
          (
            isOperator() &&
            incoming().updatedByUid == request.auth.uid
          ) ||
          (
            existing().status in ['ready', 'pending', 'applied'] &&
            incoming().status == 'completed' &&
            incoming().emailHash == existing().emailHash &&
            incoming().pinHash == existing().pinHash &&
            incoming().tokenId == existing().tokenId &&
            incoming().updatedByUid == existing().updatedByUid &&
            incoming().verifyingProofHash.matches('^[0-9a-f]{64}$') &&
            (
              (existing().emailHash.matches('^[0-9a-f]{64}$') && incoming().verifyingProofHash == existing().emailHash) ||
              (existing().pinHash.matches('^[0-9a-f]{64}$') && incoming().verifyingProofHash == existing().pinHash)
            ) &&
            incoming().nuovoPin.matches('^[0-9]{4}$') &&
            incoming().nuovoPin != '4451' &&
            incoming().completedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'nuovoPin',
              'verifyingProofHash',
              'updatedAt',
              'completedAt'
            ])
          )
        );
      allow delete: if isValidId(volunteerId) && isOperator();
    }

    // 10. Zero-PII Volunteer Shift Sign-Up Queue (works without Google / AI Studio auth)
    match /shift_signups/{signupId} {
      allow get: if isValidShiftSignupId(signupId);
      allow list: if isOperator();
      allow create: if isValidShiftSignupId(signupId) &&
        isValidShiftSignupData(incoming(), signupId) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time;
      allow update: if isValidShiftSignupId(signupId) &&
        isOperator() &&
        isValidShiftSignupData(incoming(), signupId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().signupId == existing().signupId &&
        incoming().status in ['pending', 'applied'];
      allow delete: if isValidShiftSignupId(signupId) && isOperator();
    }

    // 11. Ultra-Low-Latency Radio Walkie-Talkie Ring Slots (Fixed 14-Doc Whitelist, Zero List Queries)
    match /radio_slots/{slotId} {
      allow get: if isValidId(slotId) && isAllowedRadioSlotId(slotId) && isOperator();
      allow list: if false;
      allow create: if isValidId(slotId) &&
        isAllowedRadioSlotId(slotId) &&
        isOperator() &&
        isValidRadioSlotData(incoming(), slotId) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(slotId) &&
        isAllowedRadioSlotId(slotId) &&
        isOperator() &&
        isValidRadioSlotData(incoming(), slotId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().slotId == existing().slotId &&
        incoming().scope == existing().scope &&
        (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly(['txId', 'channelId', 'payload', 'sentAtMs', 'updatedByUid', 'updatedAt'])
        );
      allow delete: if isValidId(slotId) && isAllowedRadioSlotId(slotId) && isAdmin();
    }

    // 12. Zero-PII Web Push Subscriptions for Cross-Origin Background Radio Alerts
    match /push_subscriptions/{subId} {
      allow get: if isValidId(subId) && isOperator();
      allow list: if isOperator() && resource.data.scope == 'croce_oro_push';
      allow create: if isValidId(subId) &&
        isOperator() &&
        isValidPushSubscriptionData(incoming(), subId) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(subId) &&
        isOperator() &&
        isValidPushSubscriptionData(incoming(), subId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().subId == existing().subId &&
        incoming().scope == existing().scope &&
        (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid &&
            incoming().ownerUid == existing().ownerUid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['role', 'volontarioId', 'endpoint', 'p256dh', 'auth', 'updatedAt'])
          )
        );
      allow delete: if isValidId(subId) && (isAdmin() || (isOperator() && existing().ownerUid == request.auth.uid));
    }

    // 13. Zero-PII Public Volunteer Login Roster (Single Whitelisted Document volunteers_v1, Zero List Queries)
    match /public_roster/{rosterId} {
      allow get: if isValidId(rosterId) && rosterId == 'volunteers_v1';
      allow list: if false;
      allow create: if isValidId(rosterId) &&
        rosterId == 'volunteers_v1' &&
        isOperator() &&
        isValidPublicRosterData(incoming(), rosterId) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(rosterId) &&
        rosterId == 'volunteers_v1' &&
        isOperator() &&
        isValidPublicRosterData(incoming(), rosterId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().rosterId == existing().rosterId &&
        (
          isAdmin() ||
          (
            incoming().version > existing().version &&
            incoming().diff(existing()).affectedKeys().hasOnly(['version', 'entries', 'deletedIds', 'updatedByUid', 'updatedAt'])
          )
        );
      allow delete: if isValidId(rosterId) && rosterId == 'volunteers_v1' && isAdmin();
    }

    // 14. Zero-PII Public Shift Board (Single Whitelisted Document shifts_v1, Zero List Queries)
    match /public_board/{boardId} {
      allow get: if isValidId(boardId) && boardId == 'shifts_v1';
      allow list: if false;
      allow create: if isValidId(boardId) &&
        boardId == 'shifts_v1' &&
        isOperator() &&
        isValidPublicBoardData(incoming(), boardId) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(boardId) &&
        boardId == 'shifts_v1' &&
        isOperator() &&
        isValidPublicBoardData(incoming(), boardId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().boardId == existing().boardId &&
        (
          isAdmin() ||
          (
            incoming().version > existing().version &&
            incoming().diff(existing()).affectedKeys().hasOnly(['version', 'turni', 'sedi', 'updatedByUid', 'updatedAt'])
          )
        );
      allow delete: if isValidId(boardId) && boardId == 'shifts_v1' && isAdmin();
    }

    // 15. Zero-PII Public Raspberry Section Display Board (Single Whitelisted Document display_v1, Zero List Queries)
    match /public_raspberry/{boardId} {
      allow get: if isValidId(boardId) && boardId == 'display_v1';
      allow list: if false;
      allow create: if isValidId(boardId) &&
        boardId == 'display_v1' &&
        isOperator() &&
        isValidPublicRaspberryData(incoming(), boardId) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(boardId) &&
        boardId == 'display_v1' &&
        isOperator() &&
        isValidPublicRaspberryData(incoming(), boardId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().boardId == existing().boardId &&
        (
          isAdmin() ||
          (
            incoming().version > existing().version &&
            incoming().diff(existing()).affectedKeys().hasOnly(['version', 'sedi', 'bacheca', 'timbrature', 'config', 'updatedByUid', 'updatedAt'])
          )
        );
      allow delete: if isValidId(boardId) && boardId == 'display_v1' && isAdmin();
    }

    // 16. Zero-PII Public Course Descriptor (Token-Gated by crs-* ID, Zero List Queries)
    match /public_courses/{tokenId} {
      allow get: if isValidCourseTokenId(tokenId);
      allow list: if false;
      allow create: if isValidCourseTokenId(tokenId) &&
        isOperator() &&
        isValidPublicCourseData(incoming(), tokenId) &&
        incoming().createdAt == request.time;
      allow update: if isValidCourseTokenId(tokenId) &&
        isOperator() &&
        isValidPublicCourseData(incoming(), tokenId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().tokenId == existing().tokenId;
      allow delete: if isValidCourseTokenId(tokenId) && isOperator();
    }

    // 17. Write-Only External Guest Course Check-Ins (Zero Public Reads to Protect Guest Phone/Name PII)
    match /course_guest_checkins/{checkinId} {
      allow get: if isValidCourseGuestCheckinId(checkinId) && isOperator();
      allow list: if isOperator() && resource.data.scope == 'croce_oro_course_guest';
      allow create: if isValidCourseGuestCheckinId(checkinId) &&
        isValidCourseGuestCheckinData(incoming(), checkinId) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/public_courses/$(incoming().tokenId)) &&
        get(/databases/$(database)/documents/public_courses/$(incoming().tokenId)).data.attivo == true &&
        get(/databases/$(database)/documents/public_courses/$(incoming().tokenId)).data.corsoId == incoming().corsoId;
      allow update: if isValidCourseGuestCheckinId(checkinId) &&
        isOperator() &&
        isValidCourseGuestCheckinData(incoming(), checkinId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().checkinId == existing().checkinId &&
        incoming().scope == existing().scope &&
        incoming().tokenId == existing().tokenId &&
        incoming().corsoId == existing().corsoId &&
        incoming().status in ['pending', 'applied'];
      allow delete: if isValidCourseGuestCheckinId(checkinId) && isOperator();
    }

    // 18. Zero-PII Write-Only Volunteer Presence & Signature Channel (PIN-Hash Verified, Operator Read-Only)
    match /volunteer_activity/{volunteerId} {
      allow get: if isValidId(volunteerId) && isOperator();
      allow list: if isOperator() && resource.data.scope == 'croce_oro_vol_activity';
      allow create: if isValidId(volunteerId) &&
        isValidVolunteerActivityData(incoming(), volunteerId) &&
        incoming().createdAt == request.time &&
        (
          isOperator() ||
          (
            incoming().firmaApplied == false &&
            exists(/databases/$(database)/documents/pin_reset_profiles/$(volunteerId)) &&
            incoming().verifyingPinHash == get(/databases/$(database)/documents/pin_reset_profiles/$(volunteerId)).data.pinHash
          )
        );
      allow update: if isValidId(volunteerId) &&
        isValidVolunteerActivityData(incoming(), volunteerId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().volunteerId == existing().volunteerId &&
        incoming().scope == existing().scope &&
        (
          isAdmin() ||
          (
            isOperator() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'loggato',
              'lastHeartbeatMs',
              'firmaBase64',
              'firmaUpdatedAtMs',
              'firmaApplied',
              'updatedAt'
            ])
          ) ||
          (
            exists(/databases/$(database)/documents/pin_reset_profiles/$(volunteerId)) &&
            incoming().verifyingPinHash == get(/databases/$(database)/documents/pin_reset_profiles/$(volunteerId)).data.pinHash &&
            (
              // Action 1: Volunteer presence login / heartbeat / logout (cannot alter signature fields)
              incoming().diff(existing()).affectedKeys().hasOnly([
                'loggato',
                'lastHeartbeatMs',
                'volontarioNome',
                'mezzoScelto',
                'orarioInizio',
                'qualificaTurno',
                'verifyingPinHash',
                'updatedAt'
              ]) ||
              // Action 2: Volunteer signature upload + presence sync
              (
                incoming().firmaBase64.size() >= 20 &&
                incoming().firmaApplied == false &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'firmaBase64',
                  'firmaUpdatedAtMs',
                  'firmaApplied',
                  'loggato',
                  'lastHeartbeatMs',
                  'volontarioNome',
                  'mezzoScelto',
                  'orarioInizio',
                  'qualificaTurno',
                  'verifyingPinHash',
                  'updatedAt'
                ])
              )
            )
          )
        );
      allow delete: if isValidId(volunteerId) && isOperator();
    }

    // 19. Boot Health Check Doc (no PII)
    match /test/{docId} {
      allow get: if isValidId(docId) && docId == 'connection' && isOperator();
      allow list, write: if false;
    }
  }
}
