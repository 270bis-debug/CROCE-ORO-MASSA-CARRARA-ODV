{
  "entities": {
    "SyncShard": {
      "title": "SyncShard",
      "description": "Sharded real-time operational state document synchronized across Centrale Operativa and Volunteer terminals via Cloud Firestore.",
      "type": "object",
      "properties": {
        "shardId": {
          "type": "string",
          "description": "Fixed shard identifier (mission, volontari, servizi, turni, bacheca, magazzino, timbrature, indirizzi, checklists, config)",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "version": {
          "type": "number",
          "description": "Monotonic numeric revision counter incremented on shard updates"
        },
        "payload": {
          "type": "object",
          "description": "Native Firestore Map containing domain state fields for this shard"
        },
        "updatedByUid": {
          "type": "string",
          "description": "Firebase UID of the verified user who last wrote this shard",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedByEmail": {
          "type": "string",
          "description": "Verified email of the operator who last updated this shard",
          "minLength": 3,
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set on shard creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set on every update"
        }
      },
      "required": ["shardId", "version", "payload", "updatedByUid", "updatedByEmail", "createdAt", "updatedAt"]
    },
    "AdminEntry": {
      "title": "AdminEntry",
      "description": "Administrator authorization record granting full Centrale Operativa Cloud Sync governance.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "updatedByUid", "createdAt", "updatedAt"]
    },
    "OperatorEntry": {
      "title": "OperatorEntry",
      "description": "Approved Croce Oro operator or vehicle terminal account authorized to read and write operational sync shards.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "active": {
          "type": "boolean"
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "active", "updatedByUid", "createdAt", "updatedAt"]
    },
    "OperatorRequest": {
      "title": "OperatorRequest",
      "description": "Self-submitted access request created by a verified Google user awaiting Centrale Admin approval.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "minLength": 7,
          "maxLength": 12
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "status", "createdAt", "updatedAt"]
    },
    "PinResetTicket": {
      "title": "PinResetTicket",
      "description": "Zero-PII one-time PIN reset ticket allowing an unauthenticated volunteer with a valid secret token and provisional PIN to define their personal 4-digit access PIN without requiring a Google account.",
      "type": "object",
      "properties": {
        "tokenId": {
          "type": "string",
          "description": "High-entropy one-time reset token matching the document ID",
          "minLength": 12,
          "maxLength": 96,
          "pattern": "^rst-[a-zA-Z0-9_\\-]+$"
        },
        "volunteerId": {
          "type": "string",
          "description": "Internal volunteer identifier in the volunteers shard",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "First and last name shown on the PIN activation screen (zero PII: no email/phone/CF)",
          "minLength": 1,
          "maxLength": 120
        },
        "qualifica": {
          "type": "string",
          "description": "Operational qualification badge",
          "minLength": 1,
          "maxLength": 80
        },
        "pinProvvisorio": {
          "type": "string",
          "description": "4-digit provisional verification PIN issued by the administrator",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^[0-9]{4}$"
        },
        "pinProvvisorioVerifica": {
          "type": "string",
          "description": "Placeholder '----' on creation; matching 4-digit provisional PIN submitted by the volunteer during activation",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^(----|[0-9]{4})$"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "completed", "applied"],
          "minLength": 7,
          "maxLength": 9
        },
        "nuovoPin": {
          "type": "string",
          "description": "Empty on creation, set to 4-digit personal PIN (not 4451) upon completion",
          "minLength": 0,
          "maxLength": 4,
          "pattern": "^(|[0-9]{4})$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "tokenId",
        "volunteerId",
        "displayName",
        "qualifica",
        "pinProvvisorio",
        "pinProvvisorioVerifica",
        "status",
        "nuovoPin",
        "createdAt",
        "updatedAt",
        "completedAt"
      ]
    },
    "PinResetProfile": {
      "title": "PinResetProfile",
      "description": "Zero-PII SHA-256 verification index per volunteer enabling in-app PIN reset without Google Sign-In or any PII exposure.",
      "type": "object",
      "properties": {
        "volunteerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "emailHash": {
          "type": "string",
          "description": "SHA-256 hex digest of normalized volunteer email (empty if absent)",
          "minLength": 0,
          "maxLength": 64
        },
        "pinHash": {
          "type": "string",
          "description": "SHA-256 hex digest of volunteerId and current/provisional 4-digit PIN",
          "minLength": 0,
          "maxLength": 64
        },
        "tokenId": {
          "type": "string",
          "description": "Optional active rst-* tokenId",
          "minLength": 0,
          "maxLength": 96
        },
        "status": {
          "type": "string",
          "enum": ["ready", "pending", "completed", "applied"],
          "minLength": 5,
          "maxLength": 9
        },
        "verifyingProofHash": {
          "type": "string",
          "description": "Placeholder '----' on operator sync; matching SHA-256 proof digest submitted on unauthenticated reset",
          "minLength": 4,
          "maxLength": 64
        },
        "nuovoPin": {
          "type": "string",
          "description": "Empty unless completed; new 4-digit personal PIN (never 4451)",
          "minLength": 0,
          "maxLength": 4
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "volunteerId",
        "emailHash",
        "pinHash",
        "tokenId",
        "status",
        "verifyingProofHash",
        "nuovoPin",
        "updatedByUid",
        "createdAt",
        "updatedAt",
        "completedAt"
      ]
    },
    "ShiftSignup": {
      "title": "ShiftSignup",
      "description": "Zero-PII volunteer shift sign-up submission persisted without requiring Google Sign-In and reconciled into sync_shards/turni by Centrale Operativa.",
      "type": "object",
      "properties": {
        "signupId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 96,
          "pattern": "^cand-[a-zA-Z0-9_\\-]+$"
        },
        "turnoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sedeNome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "turnoData": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10
        },
        "turnoOrario": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "volontarioId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "volontarioNome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "qualificaVolontario": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "ruoloRichiesto": {
          "type": "string",
          "enum": ["autista", "caposervizio", "soccorritore2", "terzoSoccorritore", "operatoreCentrale", "centralinista", "osservatore"]
        },
        "note": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "dataRichiesta": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "enum": ["pending", "applied"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "signupId",
        "turnoId",
        "sedeNome",
        "turnoData",
        "turnoOrario",
        "volontarioId",
        "volontarioNome",
        "qualificaVolontario",
        "ruoloRichiesto",
        "note",
        "dataRichiesta",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/sync_shards/{shardId}": {
      "schema": { "$ref": "#/entities/SyncShard" },
      "description": "Domain-partitioned operational sync shards for missions, volunteers, shifts, vehicles warehouse, logs, addresses, and checklists."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminEntry" },
      "description": "Elevated admin identities allowed to manage operators and delete shards."
    },
    "/operators/{operatorUid}": {
      "schema": { "$ref": "#/entities/OperatorEntry" },
      "description": "Verified operators approved by Admin to participate in live multi-device Firestore sync."
    },
    "/operator_requests/{requestUid}": {
      "schema": { "$ref": "#/entities/OperatorRequest" },
      "description": "Access request queue from Google-authenticated devices pending Admin approval."
    },
    "/pin_resets/{tokenId}": {
      "schema": { "$ref": "#/entities/PinResetTicket" },
      "description": "Zero-PII token-gated one-time PIN reset tickets accessible without Google Auth."
    },
    "/pin_reset_profiles/{volunteerId}": {
      "schema": { "$ref": "#/entities/PinResetProfile" },
      "description": "Zero-PII SHA-256 write-only blind verification profiles enabling unauthenticated in-app PIN reset."
    },
    "/shift_signups/{signupId}": {
      "schema": { "$ref": "#/entities/ShiftSignup" },
      "description": "Zero-PII volunteer shift sign-up queue accessible without Google Auth."
    }
  }
}
